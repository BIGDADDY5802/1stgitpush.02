pipeline{
    agent any
    tools {
        jfrog 'Jfrog_cli'
    }
    stages {
        stage ('Testing') {
            steps {
                jf '-v' 
                jf 'c show'
                jf 'rt ping'
                sh 'touch test-file'
                jf 'rt u test-file Jfrog_cli/'
                jf 'rt bp'
                jf 'rt dl Jfrog_cli/test-file'
            }
        } 
    }
}
#mains3.tf

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "5.85.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}


resource "aws_s3_bucket" "my_s3_bucket" {
  bucket_prefix = "jenkins-bucket"

  tags = {
    Name        = "my_s3_bucket"
    Environment = "Production"
  }
}



